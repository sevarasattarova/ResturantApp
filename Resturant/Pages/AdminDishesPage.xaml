<Page x:Class="Resturant.Pages.AdminDishesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление блюдами" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Редактирование меню" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить блюдо" Click="BtnAdd_Click" Background="{DynamicResource SuccessBrush}" Width="130"/>
            <Button Content="Сохранить изменения" Click="BtnSave_Click"  Width="150" Margin="10,0"/>
            <Button Content="Удалить" Click="BtnDelete_Click" Background="{DynamicResource DangerBrush}" Width="100"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DishesGrid" AutoGenerateColumns="False" IsReadOnly="False" 
          CanUserAddRows="False" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding DishId}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} р}" Width="100"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridCheckBoxColumn Header="В наличии" Binding="{Binding IsAvailable}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>