<Page x:Class="Resturant.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация" 
      Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Создание аккаунта" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" 
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,20"/>

            <TextBlock Text="ФИО:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,5,0,5"/>
            <TextBox x:Name="TxtFullName" Height="35" Padding="5"/>

            <TextBlock Text="Логин:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,5,0,5"/>
            <TextBox x:Name="TxtLogin" Height="35" Padding="5"/>

            <TextBlock Text="Телефон (+7XXXXXXXXXX):" Foreground="{DynamicResource ForegroundBrush}" Margin="0,5,0,5"/>
            <TextBox x:Name="TxtPhone" Height="35" Padding="5" MaxLength="12"/>

            <TextBlock Text="Пароль (мин. 6 символов):" Foreground="{DynamicResource ForegroundBrush}" Margin="0,5,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="35" Padding="5"/>

            <TextBlock Text="Повторите пароль:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,5,0,5"/>
            <PasswordBox x:Name="TxtPasswordConfirm" Height="35" Padding="5"/>

            <Button Content="Зарегистрироваться" Click="BtnRegister_Click" Width="200" Height="40" Margin="0,20,0,10"/>
            <Button Content="Назад к входу" Click="BtnBackToLogin_Click" Width="200" Height="40" 
                    Background="Transparent" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="Gray"/>

            <TextBlock x:Name="TxtError" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0" 
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>