<Page x:Class="Resturant.Pages.ClientOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои заказы" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="История моих заказов" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="Столик" Binding="{Binding TableNumber}" Width="80"/>
                <DataGridTextColumn Header="Блюдо" Binding="{Binding DishName}" Width="200"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding ItemTotal, StringFormat={}{0:N2} р.}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:g}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>