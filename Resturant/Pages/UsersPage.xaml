<Page x:Class="Resturant.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Пользователи системы" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить" Click="BtnAdd_Click" Background="{DynamicResource SuccessBrush}" Width="100"/>
            <Button Content="Сохранить изменения" Click="BtnSave_Click"  Width="150" Margin="10,0"/>
            <Button Content="Удалить" Click="BtnDelete_Click" Background="{DynamicResource DangerBrush}" Width="100"/>
            <Button Content="Обновить" Click="BtnRefresh_Click"  Width="100" Margin="10,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="False" 
                  CanUserAddRows="False" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding UserId}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                <DataGridComboBoxColumn Header="Роль" SelectedItemBinding="{Binding Role}" Width="120">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <sys:String>Повар</sys:String>
                            <sys:String>Официант</sys:String>
                            <sys:String>Администратор</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>