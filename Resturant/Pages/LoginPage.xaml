<Page x:Class="Resturant.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация" 
      Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <!-- Центрируем форму по середине экрана -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Вход в систему" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" 
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtLogin" Height="35" Padding="5"/>

            <TextBlock Text="Пароль:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,10,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="35" Padding="5"/>

            <!-- Блок с капчей (скрыт по умолчанию) -->
            <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="Введите код (защита от подбора):" Foreground="Red" FontWeight="Bold"/>
                <TextBlock x:Name="TxtCaptchaCode" FontSize="22" FontWeight="Bold" Foreground="#0078D7" 
                           HorizontalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="TxtCaptchaInput" Height="30"/>
            </StackPanel>

            <Button Content="Войти" Click="BtnLogin_Click" Width="200" Height="40" Margin="0,20,0,10"/>

            <Button Content="Зарегистрироваться" Click="BtnGoToRegister_Click" Width="200" Height="40" 
                    Background="Transparent" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="Gray"/>

            <TextBlock x:Name="TxtError" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0" 
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>