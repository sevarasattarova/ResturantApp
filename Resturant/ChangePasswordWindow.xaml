<Window x:Class="Resturant.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Height="300" Width="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Старый пароль:" Margin="0,10,0,5"/>
        <PasswordBox x:Name="TxtOldPassword" Height="25"/>

        <TextBlock Text="Новый пароль:" Margin="0,10,0,5"/>
        <PasswordBox x:Name="TxtNewPassword" Height="25"/>

        <TextBlock Text="Повторите новый пароль:" Margin="0,10,0,5"/>
        <PasswordBox x:Name="TxtConfirmPassword" Height="25"/>

        <Button Content="Сохранить" Click="BtnSave_Click" Height="35" Margin="0,20,0,0" />
    </StackPanel>
</Window>