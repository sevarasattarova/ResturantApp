<Application x:Class="Resturant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- 1. ОБЪЯВЛЯЕМ РЕСУРСЫ ДЛЯ СВЕТЛОЙ ТЕМЫ -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#333333"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#0078D7"/>

        <!-- 2. ОБЪЯВЛЯЕМ СТИЛИ (единый шрифт, высота кнопок) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- 3. КОНВЕРТЕР ДЛЯ ВИДИМОСТИ -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    </Application.Resources>
</Application>